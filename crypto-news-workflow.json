    {
      "parameters": {
        "jsCode": "// Agréger et résumer les news\nconst items = $input.all();\n\nlet cryptoNews = [];\nlet politiqueNews = [];\n\n// Séparer les news par catégorie\nfor (const item of items) {\n  const title = item.json.title || '';\n  const link = item.json.link || '';\n  const pubDate = item.json.pubDate || '';\n  \n  // Détection crypto (Bitcoin, BTC, crypto)\n  if (title.toLowerCase().includes('bitcoin') || \n      title.toLowerCase().includes('btc') || \n      title.toLowerCase().includes('crypto')) {\n    cryptoNews.push({ title, link, pubDate });\n  }\n  \n  // Détection politique (government, regulation, fed, policy, ban, law)\n  if (title.toLowerCase().includes('government') || \n      title.toLowerCase().includes('regulation') ||\n      title.toLowerCase().includes('fed') ||\n      title.toLowerCase().includes('policy') ||\n      title.toLowerCase().includes('ban') ||\n      title.toLowerCase().includes('law') ||\n      title.toLowerCase().includes('president') ||\n      title.toLowerCase().includes('congress')) {\n    politiqueNews.push({ title, link, pubDate });\n  }\n}\n\n// Créer le résumé\nlet message = '📰 *RÉSUMÉ NEWS DU JOUR* 📰\\n\\n';\n\n// Section Crypto\nif (cryptoNews.length > 0) {\n  message += '🪙 *CRYPTO / BITCOIN*\\n\\n';\n  cryptoNews.slice(0, 5).forEach((news, index) => {\n    message += `${index + 1}. ${news.title}\\n${news.link}\\n\\n`;\n  });\n}\n\n// Section Politique\nif (politiqueNews.length > 0) {\n  message += '\\n🏛️ *POLITIQUE & RÉGULATION*\\n\\n';\n  politiqueNews.slice(0, 5).forEach((news, index) => {\n    message += `${index + 1}. ${news.title}\\n${news.link}\\n\\n`;\n  });\n}\n\nif (cryptoNews.length === 0 && politiqueNews.length === 0) {\n  message += '❌ Aucune news pertinente trouvée aujourd\\'hui.';\n}\n\nreturn [{ json: { message, cryptoCount: cryptoNews.length, politiqueCount: politiqueNews.length } }];"
      },
